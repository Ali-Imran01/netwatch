# Production settings. Copy to .env.production and fill in every blank. Never commit the real file.

# --- Public address ---------------------------------------------------------
SITE_DOMAIN=netwatch.example.com
# Leave as-is for real HTTPS. For a local smoke test use SITE_ADDRESS=:80, PUBLIC_SCHEME=http, PUBLIC_PORT=80.
SITE_ADDRESS=${SITE_DOMAIN}
PUBLIC_SCHEME=https
PUBLIC_PORT=443
# true: the sign-in page offers the read-only demo account (only on an instance seeded with DemoSeeder).
DEMO_LOGIN=false

# --- Application ------------------------------------------------------------
APP_NAME=NetWatch
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show
APP_KEY=
APP_URL=https://${SITE_DOMAIN}
FRONTEND_URL=https://${SITE_DOMAIN}
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Sessions: SPA and API share one origin ---------------------------------
SESSION_DRIVER=database
SESSION_DOMAIN=${SITE_DOMAIN}
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=${SITE_DOMAIN}

# --- Data stores ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=netwatch
DB_USERNAME=netwatch
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Live updates (Reverb) --------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
# Any long random strings; the KEY is public (built into the SPA), the SECRET is not.
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the app and workers reach Reverb: the internal service, never the public domain.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=${SITE_DOMAIN}

# --- Alerts (optional; add later) ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=netwatch@example.com
MAIL_FROM_NAME=NetWatch
